      "actions": ["begin_inclusion", "stop_inclusion", "begin_exclusion", "stop_exclusion", "heal_network", "heal_node", "remove_failed_node", "replace_failed_node", "set_association", "remove_association", "set_configuration_parameter", "refresh_value", "start_firmware_update", "abort_firmware_update"]
